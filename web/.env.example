# Copia este archivo como .env y rellena con los datos de tu app web de Firebase:
# Firebase Console > Configuración del proyecto > Tus apps > App web (</>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# La misma URL que FIREBASE_DATABASE_URL en src/.env de la app de escritorio
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para pruebas locales con los emuladores de Firebase
# VITE_USE_EMULATORS=true
